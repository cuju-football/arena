{
    "about": "The cases of the query language of moments, which tests/arena/test_moments.py reads for the server's reader, tests/web/moments_query.mjs for the page's reader and ci/mock_search.py for the answers of the mock. The parse cases give each query with its terms or the message id that refuses it. The find cases give the moments that the signal terms of a query find in the signals of the fixture, under the settings of the case or the shipped [search] defaults.",
    "filters": [
        "kind", "team", "player", "scenario", "source", "tournament", "match", "date", "since",
        "until", "after", "before", "score", "outcome", "limit", "value-drop", "surprise",
        "entropy", "reward", "ann"
    ],
    "signal_words": {
        "value-drop": "value-drop", "value-drops": "value-drop", "surprise": "surprise",
        "surprises": "surprise", "unlikely": "surprise"
    },
    "kind_words": [
        "goal", "goals", "own-goal", "own-goals", "owngoal", "shot", "shots", "header", "headers",
        "save", "saves", "block", "blocks", "woodwork", "post", "posts", "bar", "crossbar",
        "near-miss", "near-misses", "nearmiss", "miss", "misses", "pass", "passes", "tackle",
        "tackles", "slide", "slides", "foul", "fouls", "card", "cards", "yellow", "yellows",
        "yellow-card", "red", "reds", "red-card", "offside", "offsides", "restart", "restarts",
        "set-piece", "set-pieces", "setpiece", "corner", "corners", "free-kick", "free-kicks",
        "freekick", "penalty", "penalties", "throw-in", "throw-ins", "throwin", "goal-kick",
        "goal-kicks", "goalkick", "kickoff", "kick-off", "kickoffs", "possession", "turnover",
        "turnovers", "halftime", "half-time", "fulltime", "full-time"
    ],
    "parse": [
        {"query": "", "terms": []},
        {"query": "goal team:Greens after:60", "terms": [
            {"type": "kind", "word": "goal", "negated": false},
            {"type": "filter", "key": "team", "value": "Greens", "negated": false},
            {"type": "filter", "key": "after", "value": "60", "negated": false}
        ]},
        {"query": "goal -team:left limit:5", "terms": [
            {"type": "kind", "word": "goal", "negated": false},
            {"type": "filter", "key": "team", "value": "left", "negated": true},
            {"type": "filter", "key": "limit", "value": "5", "negated": false}
        ]},
        {"query": "team:\"Harbour Rovers\" Harbour", "terms": [
            {"type": "filter", "key": "team", "value": "Harbour Rovers", "negated": false},
            {"type": "word", "text": "Harbour", "negated": false}
        ]},
        {"query": "Corners Pénalty -pass", "terms": [
            {"type": "kind", "word": "Corners", "negated": false},
            {"type": "kind", "word": "Pénalty", "negated": false},
            {"type": "kind", "word": "pass", "negated": true}
        ]},
        {"query": "\"free-kick:x\" free-kick", "terms": [
            {"type": "word", "text": "free-kick:x", "negated": false},
            {"type": "kind", "word": "free-kick", "negated": false}
        ]},
        {"query": "\"two words\" -zzz entropy", "terms": [
            {"type": "word", "text": "two words", "negated": false},
            {"type": "word", "text": "zzz", "negated": true},
            {"type": "word", "text": "entropy", "negated": false}
        ]},
        {"query": "KIND:corner,penalty", "terms": [
            {"type": "filter", "key": "kind", "value": "corner,penalty", "negated": false}
        ]},
        {"query": "value-drop", "terms": [
            {"type": "signal", "signal": "value-drop", "name": null, "op": null, "bound": null}
        ]},
        {"query": "value-drop:value team:left", "terms": [
            {"type": "signal", "signal": "value-drop", "name": "value", "op": null, "bound": null},
            {"type": "filter", "key": "team", "value": "left", "negated": false}
        ]},
        {"query": "VALUE-DROP:\"my value\"", "terms": [
            {"type": "signal", "signal": "value-drop", "name": "my value", "op": null, "bound": null}
        ]},
        {"query": "surprise Unlikely value-drops", "terms": [
            {"type": "signal", "signal": "surprise", "name": null, "op": null, "bound": null},
            {"type": "signal", "signal": "surprise", "name": null, "op": null, "bound": null},
            {"type": "signal", "signal": "value-drop", "name": null, "op": null, "bound": null}
        ]},
        {"query": "surprise:0.05 surprise:+.1 surprise:1", "terms": [
            {"type": "signal", "signal": "surprise", "name": null, "op": null, "bound": 0.05},
            {"type": "signal", "signal": "surprise", "name": null, "op": null, "bound": 0.1},
            {"type": "signal", "signal": "surprise", "name": null, "op": null, "bound": 1}
        ]},
        {"query": "entropy:>1.5 entropy:<=0.2", "terms": [
            {"type": "signal", "signal": "entropy", "name": null, "op": ">", "bound": 1.5},
            {"type": "signal", "signal": "entropy", "name": null, "op": "<=", "bound": 0.2}
        ]},
        {"query": "reward:>0 reward:>=-1", "terms": [
            {"type": "signal", "signal": "annotation", "name": "reward", "op": ">", "bound": 0},
            {"type": "signal", "signal": "annotation", "name": "reward", "op": ">=", "bound": -1}
        ]},
        {"query": "ann:value<-0.5 ann:value<.5", "terms": [
            {"type": "signal", "signal": "annotation", "name": "value", "op": "<", "bound": -0.5},
            {"type": "signal", "signal": "annotation", "name": "value", "op": "<", "bound": 0.5}
        ]},
        {"query": "ann:\"team spirit>=2\" goal", "terms": [
            {"type": "signal", "signal": "annotation", "name": "team spirit", "op": ">=", "bound": 2},
            {"type": "kind", "word": "goal", "negated": false}
        ]},
        {"query": "foo:1", "error": "server.search.filter"},
        {"query": "free-kick:x", "error": "server.search.filter"},
        {"query": "-surprise", "error": "server.search.signal_negated"},
        {"query": "goal -value-drop:value", "error": "server.search.signal_negated"},
        {"query": "value-drop:\"\"", "error": "server.search.value_name"},
        {"query": "surprise:2", "error": "server.search.probability"},
        {"query": "surprise:high", "error": "server.search.probability"},
        {"query": "entropy:1.5", "error": "server.search.bound"},
        {"query": "entropy:>x", "error": "server.search.bound"},
        {"query": "reward:0", "error": "server.search.bound"},
        {"query": "ann:value", "error": "server.search.annotation"},
        {"query": "ann:<0.5", "error": "server.search.annotation"}
    ],
